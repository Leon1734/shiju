<Window x:Class="QuoteWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - 拾句" Width="540" Height="600" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FAFAFC">
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#44444E"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="RowCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#44444E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#77777F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <!-- 底部按钮栏固定在窗口底，中间内容超出时滚动，顶部搜索可过滤 -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10,16,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="搜索设置" VerticalAlignment="Center"
                           FontSize="13" Foreground="#44444E"/>
                <TextBox x:Name="SearchBox" Margin="10,0,0,0" FontSize="13"
                         TextChanged="OnSearchTextChanged"
                         ToolTip="输入关键词过滤设置项，如：翻译、快捷键、字体、词库；清空恢复全部"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F4" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="恢复默认" Style="{StaticResource DialogButton}"
                        Margin="0" Click="OnResetDefaults"/>
                <Button Content="关闭" Style="{StaticResource DialogButton}"
                        HorizontalAlignment="Right" Margin="0" Click="OnCloseClick"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Margin="16">
                <GroupBox Header="主题预设（一键套用）" Margin="0,0,0,12" Padding="6">
                    <StackPanel Margin="4">
                        <WrapPanel x:Name="ThemePresetsPanel"/>
                        <CheckBox Content="全透明模式下自动适配壁纸亮度（深色壁纸白字 / 浅色壁纸墨字）"
                                  Style="{StaticResource RowCheck}" IsChecked="{Binding AdaptiveTextColor}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="外观" Margin="0,0,0,12" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="背景模式" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,7">
                            <ComboBox x:Name="BgModeCombo" Width="220" HorizontalAlignment="Left"
                                      SelectedValue="{Binding BgMode}"/>
                            <TextBlock x:Name="BgOpacityHintText" Text="" FontSize="11"
                                       Foreground="#B08A8A93" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="背景色" Style="{StaticResource RowLabel}"/>
                        <DockPanel Grid.Row="1" Grid.Column="1" x:Name="BgColorRow" Margin="0,4">
                            <TextBox DockPanel.Dock="Right" x:Name="BgHexText" Width="78" VerticalAlignment="Center"
                                     Text="{Binding BgColor, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                            <WrapPanel x:Name="BgSwatches" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="不透明度" Style="{StaticResource RowLabel}"/>
                        <DockPanel Grid.Row="2" Grid.Column="1" x:Name="BgOpacityRow" Margin="0,7">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"
                                       Text="{Binding Value, ElementName=BgOpacitySlider, StringFormat={}{0:P0}}"/>
                            <Slider x:Name="BgOpacitySlider" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding BgOpacity}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="卡片圆角" Style="{StaticResource RowLabel}"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" x:Name="CornerRadiusRow" Margin="0,7">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"
                                       Text="{Binding Value, ElementName=CornerRadiusSlider, StringFormat={}{0:F0}}"/>
                            <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="32" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding CornerRadius}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="挂件宽度" Style="{StaticResource RowLabel}"/>
                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,7">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"
                                       Text="{Binding Value, ElementName=WidgetWidthSlider, StringFormat={}{0:F0}}"/>
                            <Slider x:Name="WidgetWidthSlider" Minimum="320" Maximum="640" TickFrequency="10"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding WidgetWidth}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="文字颜色" Style="{StaticResource RowLabel}"/>
                        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                            <TextBox DockPanel.Dock="Right" x:Name="TextHexText" Width="78" VerticalAlignment="Center"
                                     Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                            <WrapPanel x:Name="TextSwatches" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="字体" Style="{StaticResource RowLabel}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="FontCombo" Width="220"
                                  HorizontalAlignment="Left" Margin="0,7"
                                  SelectedItem="{Binding FontFamily}"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="字号" Style="{StaticResource RowLabel}"/>
                        <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,7">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"
                                       Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:F0}}"/>
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="28" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding FontSize}" VerticalAlignment="Center"/>
                        </DockPanel>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="行距" Style="{StaticResource RowLabel}"/>
                <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,7">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"
                               Text="{Binding Value, ElementName=LineSpacingSlider, StringFormat={}{0:F2}}"/>
                    <Slider x:Name="LineSpacingSlider" Minimum="1" Maximum="2" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            Value="{Binding LineSpacing}" VerticalAlignment="Center"/>
                </DockPanel>

                <CheckBox Grid.Row="9" Grid.Column="1" Content="文字加粗"
                          Style="{StaticResource RowCheck}" IsChecked="{Binding Bold}"/>
                <CheckBox Grid.Row="10" Grid.Column="1" Content="文字渐变色（主色上亮下深）"
                          Style="{StaticResource RowCheck}" IsChecked="{Binding GradientText}"/>
                <CheckBox Grid.Row="11" Grid.Column="1" Content="七彩文字（彩虹渐变，优先于渐变色）"
                          Style="{StaticResource RowCheck}" IsChecked="{Binding RainbowText}"/>
                <CheckBox Grid.Row="12" Grid.Column="1" x:Name="AcrylicCheck"
                          Content="亚克力模糊背景（Windows 11，切换后自动重建窗口）"
                          Style="{StaticResource RowCheck}" IsChecked="{Binding AcrylicBackdrop}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="行为" Margin="0,0,0,12" Padding="6">
                    <StackPanel Margin="4">
                        <CheckBox Content="自动换句" Style="{StaticResource RowCheck}" IsChecked="{Binding AutoSwitch}"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="换句间隔" Style="{StaticResource RowLabel}" Width="86"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"
                                       Text="{Binding Value, ElementName=IntervalSlider, StringFormat={}{0:F0} 秒}"/>
                            <Slider x:Name="IntervalSlider" Minimum="5" Maximum="300" TickFrequency="5"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding AutoSwitchSeconds}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </DockPanel>
                        <CheckBox Content="随机换句（关闭则按词库顺序播放）" Style="{StaticResource RowCheck}"
                                  IsChecked="{Binding RandomMode}"/>
                        <CheckBox Content="每日一句（每天固定一句，跨零点自动更换，手动换句仍可用）"
                                  Style="{StaticResource RowCheck}" IsChecked="{Binding DailyMode}"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="勿扰时段" Style="{StaticResource RowLabel}" Width="86"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="启用" IsChecked="{Binding DndEnabled}"
                                          VerticalAlignment="Center" Cursor="Hand"/>
                                <ComboBox x:Name="DndStartCombo" Width="64" Margin="8,0,4,0" FontSize="12"/>
                                <TextBlock Text="点 到" VerticalAlignment="Center" FontSize="12" Foreground="#44444E"/>
                                <ComboBox x:Name="DndEndCombo" Width="64" Margin="4,0,4,0" FontSize="12"/>
                                <TextBlock Text="点" VerticalAlignment="Center" FontSize="12" Foreground="#44444E"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Content="悬停时暂停自动换句" Style="{StaticResource RowCheck}"
                                  IsChecked="{Binding PauseOnHover}"/>
                        <CheckBox Content="打字机逐字显示" Style="{StaticResource RowCheck}"
                                  IsChecked="{Binding Typewriter}"/>
                        <CheckBox Content="多行句只显示第一行（悬停展开全文，如英中对照）"
                                  Style="{StaticResource RowCheck}" IsChecked="{Binding FoldMultiLine}"/>
                        <CheckBox Content="只在桌面显示（其它窗口在前台时自动隐藏，回到桌面自动出现）"
                                  Style="{StaticResource RowCheck}" IsChecked="{Binding DesktopOnlyWidget}"/>
                        <CheckBox Content="窗口置顶显示" Style="{StaticResource RowCheck}" IsChecked="{Binding Topmost}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="全局快捷键" Margin="0,0,0,12" Padding="6">
                    <StackPanel Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="换一句" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeySwitchBox" Width="150"
                                     HorizontalAlignment="Left" Margin="0,5" FontSize="12" Cursor="Hand"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="点击后直接按下组合键"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="收藏当前句" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyFavBox" Width="150"
                                     HorizontalAlignment="Left" Margin="0,5" FontSize="12" Cursor="Hand"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="点击后直接按下组合键"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="显示 / 隐藏" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeyToggleBox" Width="150"
                                     HorizontalAlignment="Left" Margin="0,5" FontSize="12" Cursor="Hand"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="点击后直接按下组合键"/>
                        </Grid>
                        <TextBlock Text="点击输入框后直接按组合键即可录入；按 Esc / 退格清除（停用）。若与其他软件冲突会注册失败，可在日志中查看。"
                                   FontSize="11" Foreground="#8A8A93" TextWrapping="Wrap" Margin="0,4,0,2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="内容" Margin="0,0,0,12" Padding="6">
                    <StackPanel Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="电影台词" IsChecked="{Binding CatMovie}" VerticalAlignment="Center"
                                          Style="{StaticResource RowCheck}" MinWidth="90" Margin="0"/>
                                <ComboBox x:Name="SchedMovie" Width="76" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="游戏台词" IsChecked="{Binding CatGame}" VerticalAlignment="Center"
                                          Style="{StaticResource RowCheck}" MinWidth="90" Margin="0"/>
                                <ComboBox x:Name="SchedGame" Width="76" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="小说名句" IsChecked="{Binding CatNovel}" VerticalAlignment="Center"
                                          Style="{StaticResource RowCheck}" MinWidth="90" Margin="0"/>
                                <ComboBox x:Name="SchedNovel" Width="76" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="音乐歌词" IsChecked="{Binding CatLyric}" VerticalAlignment="Center"
                                          Style="{StaticResource RowCheck}" MinWidth="90" Margin="0"/>
                                <ComboBox x:Name="SchedLyric" Width="76" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="联网补充「一言」随机句子" Style="{StaticResource RowCheck}"
                                  IsChecked="{Binding UseHitokoto}"/>
                        <CheckBox Content="节日彩蛋（节日当天优先出应景句并显示角标）" Style="{StaticResource RowCheck}"
                                  IsChecked="{Binding HolidayEgg}"/>
                        <TextBlock x:Name="PoolCountText" FontSize="12" Foreground="#8A8A93" Margin="0,2,0,4"/>
                        <TextBlock Text="自定义离线词库（程序目录 词库 文件夹里每个 .md / .txt 为一个分类；四个内置分类文件也在里面，可直接编辑增补）"
                                   FontSize="12" Foreground="#8A8A93" Margin="0,6,0,4" TextWrapping="Wrap"/>
                        <StackPanel x:Name="CustomBanksPanel"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Button Content="打开词库文件夹" Style="{StaticResource DialogButton}" Margin="0"
                                    Click="OnOpenBankFolder"/>
                            <Button Content="刷新词库" Style="{StaticResource DialogButton}" Click="OnRefreshBanks"/>
                            <Button Content="词库体检" Style="{StaticResource DialogButton}" Click="OnBankHealth"/>
                            <Button Content="导出词库包（分享用）" Style="{StaticResource DialogButton}" Click="OnExportBankPack"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="TranslateGroupBox" Header="翻译引擎" Margin="0,0,0,12" Padding="6">
            <StackPanel Margin="4">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="默认引擎" Style="{StaticResource RowLabel}" Width="86"/>
                    <ComboBox x:Name="TranslateEngineCombo" Width="280" HorizontalAlignment="Left" FontSize="12"/>
                </DockPanel>
                <DockPanel x:Name="EngKeyRow" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" x:Name="EngKeyLabel" Text="API Key" Style="{StaticResource RowLabel}" Width="86"/>
                    <TextBox x:Name="EngKeyBox" FontSize="12" VerticalAlignment="Center"
                             LostFocus="OnEngineKeyLostFocus"/>
                </DockPanel>
                <DockPanel x:Name="EngUrlRow" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="请求地址" Style="{StaticResource RowLabel}" Width="86"/>
                    <TextBox x:Name="EngUrlBox" FontSize="12" VerticalAlignment="Center"
                             ToolTip="官方默认地址已预填，一般无需修改"
                             LostFocus="OnEngineUrlModelLostFocus"/>
                </DockPanel>
                <DockPanel x:Name="EngModelRow" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="模型名" Style="{StaticResource RowLabel}" Width="86"/>
                    <TextBox x:Name="EngModelBox" FontSize="12" VerticalAlignment="Center"
                             ToolTip="如 deepseek-chat / glm-4-flash / qwen-turbo"
                             LostFocus="OnEngineUrlModelLostFocus"/>
                </DockPanel>
                <TextBlock x:Name="EngineHintText" FontSize="11" Foreground="#8A8A93"
                           TextWrapping="Wrap" Margin="0,2,0,4"/>
                <Button Content="打开词典文件夹" Style="{StaticResource DialogButton}"
                        HorizontalAlignment="Left" Margin="0,4,0,4" Click="OnOpenDictFolder"/>
            </StackPanel>
        </GroupBox>

                <GroupBox Header="通用" Margin="0,0,0,12" Padding="6">
                    <StackPanel Margin="4">
                        <CheckBox Content="开机自动启动" Style="{StaticResource RowCheck}" IsChecked="{Binding AutoStart}"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="开机延迟" Style="{StaticResource RowLabel}" Width="86"/>
                            <ComboBox x:Name="AutostartDelayCombo" Width="110" HorizontalAlignment="Left" FontSize="12"/>
                            <TextBlock DockPanel.Dock="Right" Text="开启自启后生效，错开开机高峰" FontSize="11"
                                       Foreground="#8A8A93" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>
                        <CheckBox Content="鼠标穿透（开启后挂件不响应鼠标，可从托盘菜单关闭）"
                                  Style="{StaticResource RowCheck}" IsChecked="{Binding ClickThrough}"/>
                        <CheckBox Content="从 GitHub 检查更新（有新 Release 提示升级、有新提交提示）"
                                  Style="{StaticResource RowCheck}" IsChecked="{Binding GitHubUpdateCheck}"/>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="#5B7DB1" Margin="0,4,0,2"
                                   Text="当前版本"/>
                        <TextBlock Text="更新检查地址（可选，自建清单用；指向 JSON 清单：{&quot;version&quot;:&quot;2.3.0&quot;,&quot;url&quot;:&quot;下载页&quot;,&quot;file&quot;:&quot;安装包直链&quot;,&quot;notes&quot;:&quot;说明&quot;}）"
                                   FontSize="12" Foreground="#44444E" Margin="0,6,0,2"/>
                        <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                 VerticalAlignment="Center" ToolTip="有新版本时托盘气泡提示"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Button Content="检查更新" Style="{StaticResource DialogButton}" Margin="0"
                                    Click="OnCheckUpdate" Cursor="Hand"/>
                            <Button Content="手动升级（选择安装包 zip/exe）" Style="{StaticResource DialogButton}"
                                    Click="OnManualUpgrade" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" FontSize="11" Foreground="#8A8A93"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Button Content="导出配置（含词库）" Style="{StaticResource DialogButton}" Margin="0"
                                    Click="OnExportConfig" Cursor="Hand"/>
                            <Button Content="导入配置" Style="{StaticResource DialogButton}"
                                    Click="OnImportConfig" Cursor="Hand"/>
                        </StackPanel>
                        <Button Content="打开数据文件夹（设置 / 收藏 / 日志）" Style="{StaticResource DialogButton}"
                                HorizontalAlignment="Left" Margin="0,4,0,4"
                                Click="OnOpenDataFolder"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
