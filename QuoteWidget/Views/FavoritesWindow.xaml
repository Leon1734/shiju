<Window x:Class="QuoteWidget.Views.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏夹 - 拾句" Width="560" Height="520"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFC">
    <Window.Resources>
        <DataTemplate x:Key="FavoriteItemTemplate">
            <Border x:Name="Bd" Padding="12,10" CornerRadius="8" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   FontSize="14" Foreground="#2D2D3A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock FontSize="11" Foreground="#8A8A93" Text="{Binding CategoryName}"/>
                            <TextBlock FontSize="11" Foreground="#8A8A93" Text=" · "/>
                            <TextBlock FontSize="11" Foreground="#8A8A93" Text="{Binding Source}"/>
                            <TextBlock FontSize="11" Foreground="#8A8A93" Text=" · 收藏于 "/>
                            <TextBlock FontSize="11" Foreground="#8A8A93" Text="{Binding SavedAtText}"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#5B7DB1" Margin="0,3,0,0"
                                   Text="{Binding TagsDisplay}"/>
                    </StackPanel>
                    <Button x:Name="DeleteBtn" Grid.Column="1" Content="删除"
                            VerticalAlignment="Top" Visibility="Hidden"
                            Cursor="Hand" Click="OnDeleteClick"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeleteBtn" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#666"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导出 TXT" Style="{StaticResource DialogButton}" Click="OnExportTxt"/>
                    <Button Content="导出 Markdown" Style="{StaticResource DialogButton}" Click="OnExportMd"/>
                    <Button Content="关闭" Style="{StaticResource DialogButton}" Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 搜索与标签工具栏 -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="搜索收藏" VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
                    <TextBox x:Name="SearchBox" Margin="6,0,0,0" FontSize="12"
                             TextChanged="OnSearchTextChanged"
                             ToolTip="按句子内容、出处或标签模糊搜索"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="标签筛选" VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
                <ComboBox x:Name="TagFilterCombo" Width="110" Margin="6,0,0,0" FontSize="12"
                          SelectionChanged="OnTagFilterChanged"/>
                <TextBlock Text="标签（逗号分隔）" VerticalAlignment="Center" FontSize="12"
                           Foreground="#666" Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="TagEditBox" Width="180" VerticalAlignment="Center" FontSize="12"
                             ToolTip="选中一条收藏后在此填写标签，逗号分隔"/>
                    <Button Content="保存标签" Style="{StaticResource DialogButton}" Click="OnSaveTags" Cursor="Hand"/>
                </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="EmptyText"
                   Text="还没有收藏。鼠标悬停到挂件上，点「♡ 收藏」就能把当前句子存进来。"
                   TextWrapping="Wrap" Foreground="#999" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>

        <ListBox x:Name="List"
                 ItemsSource="{Binding}"
                 ItemTemplate="{StaticResource FavoriteItemTemplate}"
                 BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnListDoubleClick"/>
    </DockPanel>
</Window>
